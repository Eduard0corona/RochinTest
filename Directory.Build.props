<Project>
  <!-- Propiedades comunes de todos los proyectos de la solución. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- SqlClient no admite el modo de globalización invariante. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- La especificación de solo lectura vive en la raíz del repositorio. -->
    <SpecRoot>$(MSBuildThisFileDirectory)spec</SpecRoot>
  </PropertyGroup>
</Project>
