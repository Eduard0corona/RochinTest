<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Común a los proyectos de prueba. -->
  <PropertyGroup>
    <!-- Los nombres de prueba usan guiones bajos como frases; los ayudantes de escenario no reciben el token de cancelación en cada llamada (xUnit1051). -->
    <NoWarn>$(NoWarn);CA1707;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
